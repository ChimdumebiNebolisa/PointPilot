<Window x:Class="PointPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PointPilot — deterministic workflow runner" Width="640" Height="720"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="P O I N T P I L O T" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                <TextBlock Text="Record, replay, verify Windows workflows." Margin="0,4,0,0" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,6" CornerRadius="16" Background="#E9EEF9" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#98A2B3" Margin="0,0,7,0" />
                    <TextBlock x:Name="StateText" Text="Idle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="1. Target application window" FontWeight="SemiBold" FontSize="13" />
                    <Button Grid.Column="1" Content="_Refresh windows" Click="RefreshWindows_Click" MinHeight="30" Padding="10,4" />
                </Grid>
                <ComboBox x:Name="TargetCombo" Margin="0,8,0,0" MinHeight="34" SelectionChanged="Target_SelectionChanged" />
                <TextBlock x:Name="TargetDetails" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="Select the running application a workflow should bind to." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <StackPanel>
                <TextBlock Text="2. Workflow — record or load" FontWeight="SemiBold" FontSize="13" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="LoadButton" Content="_Load YAML…" Click="LoadWorkflow_Click" MinHeight="34" />
                    <Button x:Name="RecordButton" Content="_Start recording" Click="RecordButton_Click" Margin="8,0,0,0" MinHeight="34" />
                    <Button x:Name="SaveDraftButton" Content="S_ave draft…" Click="SaveDraft_Click" Margin="8,0,0,0" MinHeight="34" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="WorkflowPathText" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="No workflow loaded." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <StackPanel>
                <TextBlock Text="3. Inspect steps" FontWeight="SemiBold" FontSize="13" />
                <ListBox x:Name="StepsList" Height="130" Margin="0,8,0,0" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Workflow steps" />
                <TextBlock x:Name="ValidationText" Margin="0,8,0,0" FontSize="11.5" Foreground="#B42318" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DryRunButton" Content="_Dry run" Click="DryRun_Click" MinHeight="38" />
                    <Button x:Name="RunButton" Content="_Run workflow" Click="Run_Click" Margin="8,0,0,0" MinHeight="38" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" />
                    <Button x:Name="StopButton" Content="_Stop" Click="Stop_Click" Margin="8,0,0,0" MinHeight="38" IsEnabled="False" />
                    <Button x:Name="OpenTraceButton" Content="_Open trace folder" Click="OpenTrace_Click" Margin="8,0,0,0" MinHeight="38" />
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,10,0,0" FontWeight="SemiBold" Text="Load or record a workflow to begin. Escape stops an active run." TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ResultBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             AutomationProperties.Name="Run results" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   Text="Runs bind to one process and window; input is only sent while that exact window keeps foreground. Escape stops the active run." TextWrapping="Wrap" />
    </Grid>
</Window>
