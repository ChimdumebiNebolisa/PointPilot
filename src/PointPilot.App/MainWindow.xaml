<Window x:Class="PointPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PointPilot" Width="430" Height="610" MinWidth="390" MinHeight="540"
        WindowStartupLocation="Manual" Background="#F7F8FA" Foreground="{StaticResource InkBrush}"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="P O I N T P I L O T" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                <TextBlock Text="Help that stays with you." Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,6" CornerRadius="16" Background="#E9EEF9" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#98A2B3" Margin="0,0,7,0" />
                    <TextBlock x:Name="StateText" Text="Idle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="#EAF0FF" VerticalAlignment="Top">
                    <TextBlock Text="◎" Foreground="#2563EB" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Foreground context" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ContextTitle" Text="Ready to look at the active window" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Act mode is verified only for GIMP 3.x" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ConfirmationPanel" Grid.Row="2" Margin="0,12,0,0" Padding="15" CornerRadius="10" BorderBrush="#F2B84B" BorderThickness="1" Background="#FFF9E8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Confirmation required" FontWeight="SemiBold" />
                <TextBlock x:Name="ConfirmationDetails" Margin="0,5,0,10" Foreground="#6B5730" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton" Content="_Confirm exact export" Click="ConfirmButton_Click" IsDefault="True" />
                    <Button Content="_Cancel" Margin="8,0,0,0" Click="CancelConfirmation_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="16" CornerRadius="10" BorderBrush="#E3E7EF" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Conversation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TranscriptText" Text="Start a session, then ask what you’re looking at—or ask PointPilot to take over in GIMP." TextWrapping="Wrap" FontSize="14" LineHeight="22" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="SessionButton" Content="_Start listening" Click="SessionButton_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" />
                <Button x:Name="MuteButton" Grid.Column="1" Content="_Mute" Click="MuteButton_Click" Margin="8,0,0,0" IsEnabled="False" />
                <Button x:Name="PauseButton" Grid.Column="2" Content="_Pause" Click="PauseButton_Click" Margin="8,0,0,0" IsEnabled="False" />
                <Button x:Name="EndButton" Grid.Column="3" Content="_End" Click="EndButton_Click" Margin="8,0,0,0" IsEnabled="False" />
            </Grid>
            <TextBlock Text="Ctrl+Alt+Space starts or shows PointPilot · Escape stops active control" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
        </StackPanel>

        <wv2:WebView2 x:Name="RealtimeWebView" Grid.Row="5" Width="1" Height="1" />
    </Grid>
</Window>
