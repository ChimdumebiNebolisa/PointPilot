<Window x:Class="PointPilot.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        IsHitTestVisible="False" Focusable="False">
    <Grid>
        <Border BorderBrush="#2563EB" BorderThickness="3" CornerRadius="8" Background="#182563EB">
            <Border.Effect><DropShadowEffect Color="#2563EB" BlurRadius="14" Opacity="0.42" ShadowDepth="0" /></Border.Effect>
        </Border>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,-30,0,0" Padding="9,5" CornerRadius="6" Background="#FF172033">
            <TextBlock Text="PointPilot" Foreground="White" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
